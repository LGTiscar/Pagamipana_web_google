# Supabase — copy to .env.local and fill with your project's values
# (Project Settings → API / Data API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# CAPTCHA (opcional): site key de Cloudflare Turnstile. Si se define, el login
# muestra el captcha y lo exige (debe coincidir con el activado en Supabase Auth).
# En dev puedes usar la test key de Cloudflare: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
